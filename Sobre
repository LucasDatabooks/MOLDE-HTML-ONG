CSS

/* ==========================================================================
   PALETA DE CORES E VARIAVEIS GLOBAIS DO PROJETO
   ========================================================================== */
:root {
  /* Cores Principais baseadas na Especificação do Projeto */
  --purple-main: #5F0F40;   /* Roxo profundo */
  --purple-sec: #5f0f40;    /* Roxo claro (usado no Navbar) */
  --purple-accent: #CF51B8; /* Rosa-arroxeado */
  --yellow-main: #FCBA07;   /* Amarelo vibrante */
  --yellow-sec: #FED65C;    /* Amarelo suave */
  --orange-main: #D35D14;   /* Laranja queimado */
  --orange-sec: #F38836;    /* Laranja vibrante */
  --text-color: #181818;    /* Cor do texto (Preto suave) */
  --bg-light: #FDFBF8;      /* Fundo claro das secções */
  --white: #FFFFFF;         /* Branco puro */
  --footer-bg: #121212;     /* Fundo escuro do Rodapé */
  --transition: all 0.3s ease; /* Transição suave para efeitos de hover */
}

/* Reset básico de margens e configuração de box-model para evitar estouro de largura */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Estilização padrão do corpo do documento */
body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  color: var(--text-color);
  background-color: var(--bg-light);
  line-height: 1.6;
}

/* Container centralizado para alinhar os conteúdos da página */
.container {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}

/* ==========================================================================
   ESTILIZACAO DA NAVBAR (CABEÇALHO FIXO)
   ========================================================================== */
.navbar {
  background-color: var(--purple-sec); /* Roxo-magenta institucional */
  padding: 12px 40px;
  width: 100%;
  position: sticky; /* Mantém a navbar fixa no topo durante o scroll */
  top: 0;
  z-index: 1000;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15); /* Sombra suave abaixo do cabeçalho */
}

/* Layout interno do container da Navbar utilizando Flexbox */
.nav-container {
  display: flex;
  justify-content: space-between; /* Espaça a logo à esquerda e o menu à direita */
  align-items: right;
  width: 100%;
  max-width: 1300px;
  margin: 0 auto;
}

/* Estilização da área da marca/logo */
.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-logo {
  width: 55px;
  height: 50px;
}

.titulo {
  display: flex;
  flex-direction: column;
}

.titulo h1 {
  color: #FFFFFF;
  font-size: 22px;
  font-weight: 800;
  line-height: 1.1;
  margin: 0;
}

.titulo h2 {
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
  opacity: 0.95;
  margin: 0;
}

/* Lista dos links do menu de navegação superior */
.nav-links {
  list-style: none;
  display: flex;
  gap: 24px;
  align-items: center;
}

.nav-links li a {
  color: #FFFFFF;
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
  transition: var(--transition);
}

/* Efeito ao passar o mouse ou no link da página ativa */
.nav-links li a:hover,
.nav-links li a.active {
  color: var(--yellow-sec);
  text-decoration: underline;
}

/* Ícone do Menu Hambúrguer (Oculto em telas de computador) */
.menu-toggle {
  display: none;
  flex-direction: column;
  cursor: pointer;
  gap: 5px;
}

.menu-toggle .bar {
  width: 28px;
  height: 3px;
  background-color: #FFFFFF;
  border-radius: 2px;
  transition: var(--transition);
}

/* ==========================================================================
   CONTEUDO PRINCIPAL DA PAGINA SOBRE / NOSSA HISTORIA
   ========================================================================== */
/* Banner de destaque com gradiente */
.hero-sobre {
  background: linear-gradient(135deg, var(--purple-main) 0%, var(--purple-sec) 60%, var(--orange-main) 100%);
  color: var(--white);
  padding: 5rem 0;
  text-align: center;
}

.badge {
  background: rgba(255, 255, 255, 0.15);
  padding: 0.4rem 1.2rem;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 600;
  display: inline-block;
  margin-bottom: 1.2rem;
}

.hero-sobre h1 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 1rem;
  line-height: 1.2;
}

.hero-sobre p {
  font-size: 1.1rem;
  opacity: 0.9;
  max-width: 700px;
  margin: 0 auto;
}

.section {
  padding: 4rem 0;
}

.bg-light {
  background-color: #F7F3F5;
}

.section-title {
  text-align: center;
  margin-bottom: 3rem;
}

.section-title h2 {
  font-size: 2.2rem;
  color: var(--purple-main);
  margin-bottom: 0.5rem;
}

.section-title p {
  color: #666;
}

/* Grelha responsiva de 3 colunas para os cartões de Missão, Visão e Valores */
.grid-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
}

.card {
  background: var(--white);
  border-radius: 16px;
  padding: 2rem;
  box-shadow: 0 5px 20px rgba(0,0,0,0.04);
  transition: var(--transition);
}

.card:hover {
  transform: translateY(-5px); /* Efeito de elevação ao passar o mouse */
  box-shadow: 0 15px 30px rgba(0,0,0,0.1);
}

.icon-box {
  width: 60px;
  height: 60px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  margin-bottom: 1.5rem;
}

.icon-purple { background: rgba(95, 15, 64, 0.1); }
.icon-yellow { background: rgba(252, 186, 7, 0.2); }
.icon-orange { background: rgba(211, 93, 20, 0.1); }

.pillar-card h3 {
  color: var(--purple-main);
  margin-bottom: 1rem;
}

/* Secção de Público Atendido utilizando Flexbox */
.publico-container {
  display: flex;
  align-items: center;
  gap: 3rem;
  flex-wrap: wrap;
}

.publico-texto {
  flex: 1;
  min-width: 280px;
}

.publico-texto h2 {
  color: var(--purple-main);
  font-size: 2rem;
  margin-bottom: 1rem;
}

.publico-list {
  list-style-type: disc;
  padding-left: 1.2rem;
  margin-top: 1rem;
}

.publico-list li {
  margin-bottom: 0.8rem;
}

.publico-imagem {
  flex: 1;
  min-width: 280px;
  text-align: center;
}

.publico-imagem img {
  width: 100%;
  max-width: 500px;
  border-radius: 12px;
  box-shadow: 0 8px 25px rgba(0,0,0,0.08);
}

/* ==========================================================================
   ESTILIZACAO DO FOOTER (RODAPÉ ESCURO CENTRALIZADO)
   ========================================================================== */
.footer {
  background-color: var(--footer-bg);
  color: #CCCCCC;
  padding: 35px 20px;
  text-align: center;
}

.footer-container {
  max-width: 950px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.copyright {
  font-size: 14px;
  color: #FFFFFF;
  font-weight: 500;
}

/* Texto contínuo com a lista dos alunos integrantes do grupo */
.integrantes {
  font-size: 12px;
  color: #ffffff;
  line-height: 1.6;
  max-width: 850px;
}

.footer-links {
  display: flex;
  gap: 20px;
  margin-top: 5px;
}

.footer-links a {
  color: #888888;
  text-decoration: none;
  font-size: 12px;
  transition: var(--transition);
}

.footer-links a:hover {
  color: #FFFFFF;
  text-decoration: underline;
}

/* ==========================================================================
   REGRAS DE RESPONSIVIDADE (MEDIA QUERIES PARA CELULAR E TABLET)
   ========================================================================== */
@media (max-width: 768px) {
  .navbar {
    padding: 12px 20px;
  }

  /* Exibe o ícone hambúrguer em dispositivos móveis */
  .menu-toggle {
    display: flex;
  }

  /* Esconde os links por padrão no celular, abrindo apenas com o clique */
  .nav-links {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--purple-sec);
    padding: 20px 0;
    box-shadow: 0 10px 15px rgba(0,0,0,0.2);
  }

  /* Classe adicionada via JavaScript quando o menu é clicado no celular */
  .nav-links.active {
    display: flex;
  }

  .publico-container {
    flex-direction: column;
  }

  .footer-links {
    flex-direction: column;
    gap: 8px;
  }
}

// ==========================================================================
// INTERATIVIDADE JAVASCRIPT - MENU HAMBÚRGUER EM DISPOSITIVOS MÓVEIS
// ==========================================================================

// Aguarda o carregamento completo do DOM da página antes de executar
document.addEventListener('DOMContentLoaded', () => {

    // Seleciona o elemento do botão hambúrguer pelo seu ID
    const menuToggle = document.getElementById('mobile-menu');
    
    // Seleciona a lista de links da navegação
    const navLinks = document.querySelector('.nav-links');

    // Verifica se os dois elementos existem na página antes de adicionar o evento
    if (menuToggle && navLinks) {
        
        // Adiciona um ouvinte de evento para o clique no botão hambúrguer
        menuToggle.addEventListener('click', () => {
            
            // Alterna a classe 'active' para abrir ou fechar o menu no celular
            navLinks.classList.toggle('active');
        });
    }
});
